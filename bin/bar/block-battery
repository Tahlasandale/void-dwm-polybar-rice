#!/bin/sh
# Batterie : pourcentage / autonomie / jauge (shell pur, sans python3)
if [ -z "$XDG_RUNTIME_DIR" ]; then export XDG_RUNTIME_DIR="/tmp/run-user-1000"; fi
MODE_FILE="$HOME/.cache/dwm-battery-mode"
SHOW_INFO=0
case "${BLOCK_BUTTON:-0}" in
    1)
        CUR=$(cat "$MODE_FILE" 2>/dev/null || echo "percent")
        if [ "$CUR" = "percent" ]; then
            echo "time" > "$MODE_FILE"
        else
            echo "percent" > "$MODE_FILE"
        fi
        SHOW_INFO=1
        ;;
    3)
        SHOW_INFO=1
        ;;
esac

BAT=""
for b in /sys/class/power_supply/BAT*; do
    if [ -d "$b" ]; then BAT=$b; break; fi
done

read_val() {
    [ -n "$BAT" ] || { printf '%s' "$2"; return 0; }
    if [ -r "$BAT/$1" ]; then cat "$BAT/$1" 2>/dev/null; else printf '%s' "$2"; fi
}

if [ -z "$BAT" ]; then
    [ "$SHOW_INFO" -eq 1 ] && notify-send -u low -t 3000 "Batterie" "Alimentation secteur (AC)" >/dev/null 2>&1 &
    printf '%%{F#6c7086} %5s%%{F-}\n' "AC"
    exit 0
fi

STATUS=$(read_val status Unknown)
CAPACITY=$(read_val capacity 0)
NOW=$(read_val charge_now "$(read_val energy_now 0)")
FULL=$(read_val charge_full "$(read_val energy_full 0)")
CURRENT=$(read_val current_now "$(read_val power_now 0)")

for NAME in CAPA NOW FULL CURRENT; do
    eval "VAL=\$$NAME"
    case "$VAL" in ''|*[!0-9]*) eval "$NAME=0" ;; esac
done

ICON0='󰁹'; ICON1='󰁻'; ICON2='󰁾'; ICON3='󰂁'; ICON4='󱊣'
IDX=$((CAPACITY / 20))
[ "$IDX" -gt 4 ] && IDX=4
case "$IDX" in
    0) ICON=$ICON0 ;;
    1) ICON=$ICON1 ;;
    2) ICON=$ICON2 ;;
    3) ICON=$ICON3 ;;
    *) ICON=$ICON4 ;;
esac

TIME_STR=""
case "$STATUS" in
    Charging)
        ICON='󰂄'
        REMAIN=$((FULL - NOW))
        [ "$REMAIN" -lt 0 ] && REMAIN=0
        if [ "$CURRENT" -gt 0 ]; then
            TOTAL_MIN=$(( (REMAIN * 60 + CURRENT / 2) / CURRENT ))
            TIME_STR=$(printf '%dh%02dm' "$((TOTAL_MIN / 60))" "$((TOTAL_MIN % 60))")
        else
            TIME_STR="$CAPACITY%"
        fi
        ;;
    Discharging)
        if [ "$CURRENT" -gt 0 ]; then
            TOTAL_MIN=$(( (NOW * 60 + CURRENT / 2) / CURRENT ))
            TIME_STR=$(printf '%dh%02dm' "$((TOTAL_MIN / 60))" "$((TOTAL_MIN % 60))")
        else
            TIME_STR="$CAPACITY%"
        fi
        ;;
    Full|Plugged)
        TIME_STR='Plein'
        ;;
    *)
        if [ "$CAPACITY" -ge 99 ]; then TIME_STR='Plein'; else TIME_STR='AC'; fi
        ;;
esac

if [ "$SHOW_INFO" -eq 1 ]; then
    case "$STATUS" in
        Charging) LSTATUS='En charge' ;;
        Discharging) LSTATUS='Décharge' ;;
        Full|Plugged) LSTATUS='Pleine' ;;
        *) LSTATUS="$STATUS" ;;
    esac
    if [ -r "$BAT/current_now" ] && [ "$CURRENT" -gt 0 ]; then
        CUR_TEXT="$((CURRENT / 1000)) mA"
    elif [ "$CURRENT" -gt 0 ]; then
        CUR_TEXT="$((CURRENT / 1000000)) W"
    else
        CUR_TEXT='n/a'
    fi
    CYCLES=$(read_val cycle_count '?')
    INFO=$(printf 'Batterie : %s %% (%s)\nAutonomie : %s\nCourant : %s\nCycles : %s' \
        "$CAPACITY" "$LSTATUS" "$TIME_STR" "$CUR_TEXT" "$CYCLES")
    notify-send -u low -t 6000 "Batterie" "$INFO" >/dev/null 2>&1 &
fi

MODE=$(cat "$MODE_FILE" 2>/dev/null || echo "percent")
if [ "$MODE" = "time" ] && [ -n "$TIME_STR" ]; then
    VALUE="$TIME_STR"
else
    VALUE="$CAPACITY%"
fi

printf '%%{F#89b4fa}%%{T6}%s%%{T-}%%{F-} %5s%%{F-}\n' "$ICON" "$VALUE"
