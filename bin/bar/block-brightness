#!/bin/sh
if [ -z "$XDG_RUNTIME_DIR" ]; then export XDG_RUNTIME_DIR="/tmp/run-user-1000"; fi
# ~/.local/bin/bar/block-brightness — Rétroéclairage / Luminosité

case "${BLOCK_BUTTON:-${BUTTON:-0}}" in
    4) # Molette haut = +5%
        brightnessctl --class=backlight set 5%+ >/dev/null 2>&1 || true
        ;;
    5) # Molette bas = -5%
        brightnessctl --class=backlight set 5%- >/dev/null 2>&1 || true
        ;;
esac

PERC=""
if command -v brightnessctl >/dev/null 2>&1; then
    PERC=$(brightnessctl --class=backlight -m 2>/dev/null | head -n1 | cut -d, -f4 | tr -d '%')
fi

if [ -z "$PERC" ]; then
    for b in /sys/class/backlight/*; do
        if [ -d "$b" ] && [ -r "$b/brightness" ] && [ -r "$b/max_brightness" ]; then
            CUR=$(cat "$b/brightness" 2>/dev/null)
            MAX=$(cat "$b/max_brightness" 2>/dev/null)
            if [ -n "$MAX" ] && [ "$MAX" -gt 0 ] 2>/dev/null; then
                PERC=$((CUR * 100 / MAX))
                break
            fi
        fi
    done
fi

# Fallback gracieux (ex: VM sans contrôleur matériel de rétroéclairage)
[ -z "$PERC" ] && PERC=100

printf "%%{T2}%%{T-} %d%%\n" "$PERC"
