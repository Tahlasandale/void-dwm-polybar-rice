#!/bin/sh
if [ -z "$XDG_RUNTIME_DIR" ]; then export XDG_RUNTIME_DIR="/tmp/run-user-1000"; fi
# Verrouillage Clavier : Verr Num & Verr Maj (Caps Lock & Num Lock)
Q=$(xset q 2>/dev/null || true)
CAPS=$(printf "%s" "$Q" | grep "Caps Lock:" | awk '{print $4}')
NUM=$(printf "%s" "$Q" | grep "Num Lock:" | awk '{print $8}')

OUT=""
if [ "$CAPS" = "on" ]; then
    OUT="󰬈 CAPS"
fi
if [ "$NUM" = "on" ]; then
    if [ -n "$OUT" ]; then
        OUT="$OUT 󰬕 NUM"
    else
        OUT="󰬕 NUM"
    fi
fi

if [ -n "$OUT" ]; then
    printf "%s\n" "$OUT"
else
    printf "\n"
fi
