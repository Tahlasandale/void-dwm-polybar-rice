#!/bin/sh
if [ -z "$XDG_RUNTIME_DIR" ]; then export XDG_RUNTIME_DIR="/tmp/run-user-1000"; fi
# MEGAsync / MEGAcmd status and control
case "${BLOCK_BUTTON:-0}" in
    1)
        if pgrep -f "mega-cmd-server|megasync" >/dev/null 2>&1; then
            mega-quit >/dev/null 2>&1 || pkill -f mega-cmd-server 2>/dev/null || true
        else
            if command -v mega-cmd-server >/dev/null 2>&1; then
                mega-cmd-server >/dev/null 2>&1 &
            elif command -v megasync >/dev/null 2>&1; then
                megasync >/dev/null 2>&1 &
            fi
        fi
        sleep 0.5
        ;;
    3)
        if command -v mega-cmd >/dev/null 2>&1; then
            alacritty -T "MEGA Shell" -e mega-cmd &
        fi
        ;;
esac

if pgrep -f "mega-cmd-server|megasync" >/dev/null 2>&1; then
    printf " [ON]\n"
else
    printf " [OFF]\n"
fi
