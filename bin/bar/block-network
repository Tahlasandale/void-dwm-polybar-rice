#!/bin/sh
if [ -z "$XDG_RUNTIME_DIR" ]; then export XDG_RUNTIME_DIR="/tmp/run-user-1000"; fi
# Wi-Fi / Reseau
case "${BLOCK_BUTTON:-0}" in
    1|3) alacritty -T "Network Manager" -e nmtui & ;; # clic = nmtui
esac

SSID=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | grep '^yes:' | cut -d: -f2 | head -n 1 || true)
if [ -n "$SSID" ]; then
    printf " %s\n" "$SSID"
    exit 0
fi

# Fallback iwgetid
if command -v iwgetid >/dev/null 2>&1; then
    W_SSID=$(iwgetid -r 2>/dev/null || true)
    if [ -n "$W_SSID" ]; then
        printf " %s\n" "$W_SSID"
        exit 0
    fi
fi

# Vérifier liaison filaire ou active
if ip route | grep -q default; then
    printf "󰈀\n"
else
    printf "%%{F#6c7086}󰤮%%{F-}\n"
fi
