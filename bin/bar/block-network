#!/bin/sh
if [ -z "$XDG_RUNTIME_DIR" ]; then export XDG_RUNTIME_DIR="/tmp/run-user-$(id -u)"; fi

# Clic gauche ou droit : ouvrir nmtui
case "${BLOCK_BUTTON:-0}" in
    1|3) alacritty -T "Network Manager" -e nmtui & ;;
esac

# Trouver l interface par defaut (routeur)
DEV=$(ip -4 route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1); exit}')

if [ -z "$DEV" ]; then
    # Aucun acces reseau
    printf "%%{F#6c7086}%%{T6}󰤭%%{T-}%%{F-} %14s%%{F-}\n" "Off"
    exit 0
fi

# Verifier si l interface est sans-fil
IS_WIRELESS=0
if [ -d "/sys/class/net/$DEV/wireless" ] || [ -d "/sys/class/net/$DEV/phy80211" ]; then
    IS_WIRELESS=1
fi

if [ "$IS_WIRELESS" -eq 1 ]; then
    # Obtenir le SSID de maniere instantanee via NetworkManager
    SSID=$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev 2>/dev/null | awk -F: -v d="$DEV" '$1==d && $2=="wifi" && $3=="connected" {print $4; exit}')
    
    # Fallback iw si SSID vide
    if [ -z "$SSID" ]; then
        SSID=$(iw dev "$DEV" link 2>/dev/null | awk '/SSID:/ {print $2; exit}')
    fi
    
    # Fallback nmcli dev wifi
    if [ -z "$SSID" ]; then
        SSID=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1=="yes" {print $2; exit}')
    fi

    if [ -n "$SSID" ]; then
        SHORT_SSID=$(echo "$SSID" | cut -c1-14)
        printf "%%{F#89b4fa}%%{T6}󰖩%%{T-}%%{F-} %14s%%{F-}\n" "$SHORT_SSID"
    else
        printf "%%{F#89b4fa}%%{T6}󰖩%%{T-}%%{F-} %14s%%{F-}\n" "Connecté"
    fi
else
    # Interface filaire Ethernet reelle
    printf "%%{F#89b4fa}%%{T6}󰈀%%{T-}%%{F-} %14s%%{F-}\n" "$DEV"
fi
