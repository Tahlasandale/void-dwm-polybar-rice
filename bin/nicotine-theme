#!/bin/sh
# ~/.local/bin/nicotine-theme — Moteur de bascule instantanee Dark <-> E-Ink
set -eu

if [ -z "${DISPLAY:-}" ]; then
    NEWEST_SOCK=$(ls -t /tmp/.X11-unix/X* 2>/dev/null | head -n 1 || true)
    if [ -n "$NEWEST_SOCK" ]; then
        DISP_NUM=$(basename "$NEWEST_SOCK" | sed 's/^X//')
        export DISPLAY=":${DISP_NUM}"
    else
        export DISPLAY=":0"
    fi
fi

STATE_FILE="$HOME/.cache/nicotine-theme"
CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo "dark")

TARGET="${1:-toggle}"
if [ "$TARGET" = "toggle" ]; then
    if [ "$CURRENT" = "dark" ]; then
        TARGET="eink"
    else
        TARGET="dark"
    fi
elif [ "$TARGET" = "restore" ]; then
    TARGET="$CURRENT"
fi

mkdir -p "$HOME/.cache"
echo "$TARGET" > "$STATE_FILE"

# 1. Alacritty : liens relatifs vers la palette active
mkdir -p "$HOME/.config/alacritty/themes"
if [ "$TARGET" = "eink" ]; then
    (cd "$HOME/.config/alacritty" && ln -sfn themes/eink.toml colors.toml)
else
    (cd "$HOME/.config/alacritty" && ln -sfn themes/catppuccin-mocha.toml colors.toml)
fi
touch "$HOME/.config/alacritty/alacritty.toml" 2>/dev/null || true

# 2. Dunst : lien relatif + rechargement a chaud
mkdir -p "$HOME/.config/dunst"
if [ "$TARGET" = "eink" ]; then
    (cd "$HOME/.config/dunst" && ln -sfn dunstrc-eink dunstrc)
else
    (cd "$HOME/.config/dunst" && ln -sfn dunstrc-dark dunstrc)
fi
if command -v dunstctl >/dev/null 2>&1; then
    dunstctl reload 2>/dev/null || true
fi

# 3. Polybar : palette via lien relatif, puis relance
mkdir -p "$HOME/.config/polybar/themes"
if [ -f "$HOME/.config/polybar/themes/${TARGET}.ini" ]; then
    (cd "$HOME/.config/polybar" && ln -sfn "themes/${TARGET}.ini" colors.ini)
    if [ -x "$HOME/.config/polybar/launch.sh" ]; then
        "$HOME/.config/polybar/launch.sh" &
    fi
fi

# 4. Fond d'ecran
if [ -x "$HOME/.local/bin/next-wallpaper.sh" ]; then
    "$HOME/.local/bin/next-wallpaper.sh" 2>/dev/null || true
elif [ "$TARGET" = "eink" ]; then
    xsetroot -solid "#f5f4ed" 2>/dev/null || true
else
    xsetroot -solid "#1e1e2e" 2>/dev/null || true
fi

# 5. Notification visuelle
if command -v notify-send >/dev/null 2>&1; then
    notify-send -u normal -t 2500 "Thème actif" "Mode : $(echo "$TARGET" | tr '[:lower:]' '[:upper:]')" 2>/dev/null || true
fi
