[global]
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    width = (0, 350)
    offset = (20, 45)
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    separator_color = frame
    corner_radius = 4

[urgency_low]
    background = "#f5f4ed"
    foreground = "#000000"
    frame_color = "#000000"
    timeout = 3

[urgency_normal]
    background = "#f5f4ed"
    foreground = "#000000"
    frame_color = "#000000"
    timeout = 5

[urgency_critical]
    background = "#ffffff"
    foreground = "#8b0000"
    frame_color = "#8b0000"
    timeout = 0
