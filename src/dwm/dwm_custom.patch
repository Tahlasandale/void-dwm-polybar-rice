+void
+cycleview(const Arg *arg)
+{
+	unsigned int cur = selmon->tagset[selmon->seltags] & TAGMASK;
+	unsigned int next;
+	if (arg->i > 0) {
+		next = (cur << 1) & TAGMASK;
+		if (!next)
+			next = 1;
+	} else {
+		next = cur >> 1;
+		if (!next)
+			next = 1 << (LENGTH(tags) - 1);
+	}
+	Arg a = { .ui = next };
+	view(&a);
+}
+
+void
+movetoworkspace(const Arg *arg)
+{
+	if (selmon->sel)
+		tag(arg);
+	view(arg);
+}
