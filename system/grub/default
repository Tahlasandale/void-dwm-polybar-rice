# CrossCode Grub Theme configuration for MacBook Air 2015
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="VoidLinux"

GRUB_THEME="/boot/grub/themes/crossgrub/theme.txt"
GRUB_GFXMODE="1440x900x32,1440x900,auto"
GRUB_GFXPAYLOAD_LINUX="keep"
GRUB_TERMINAL_OUTPUT="gfxterm"

GRUB_CMDLINE_LINUX_DEFAULT="loglevel=4 fbcon=nodefer i915.fastboot=1"
GRUB_CMDLINE_LINUX=""
GRUB_DISABLE_OS_PROBER=false
